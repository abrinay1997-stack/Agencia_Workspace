{
  "name": "agencia-workspace-agent",
  "version": "0.1.0",
  "private": true,
  "description": "Agente diario multi-cliente para Juancito Ads. Lee ADN por cliente, corre capabilities declaradas en su manifiesto y envía reporte por email + commit al repo.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "agent": "tsx agent/run.ts",
    "typecheck": "tsc --noEmit",
    "list-clients": "tsx agent/scripts/list-clients.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.32.1",
    "resend": "^4.0.0",
    "js-yaml": "^4.1.0",
    "eta": "^3.5.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^20.14.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  }
}
