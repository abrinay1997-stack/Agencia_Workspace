<!DOCTYPE html>
<html lang="es">
<head>
<meta charset="UTF-8">
<title><%= it.report.client.clientName %> — <%= it.report.runDate %></title>
<style>
  body { font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif; max-width: 720px; margin: 0 auto; padding: 24px; color: #1a1a1a; background: #fafafa; }
  h1 { font-size: 22px; margin: 0 0 4px; }
  h2 { font-size: 17px; margin-top: 28px; padding-bottom: 6px; border-bottom: 2px solid #1648C0; color: #1648C0; }
  h3 { font-size: 14px; margin-top: 18px; color: #333; }
  .meta { color: #666; font-size: 12px; margin-bottom: 20px; }
  .abort { background: #fff3cd; border-left: 4px solid #ffc107; padding: 12px 16px; border-radius: 4px; margin: 16px 0; }
  .warn-list { background: #f5f5f5; border-radius: 6px; padding: 12px 16px; font-size: 12px; color: #555; margin-top: 32px; }
  ul { padding-left: 20px; }
  li { margin: 4px 0; }
  code { background: #eee; padding: 2px 6px; border-radius: 3px; font-size: 12px; }
  pre, p { white-space: pre-wrap; }
</style>
</head>
<body>
  <h1><%= it.report.client.clientName %></h1>
  <div class="meta">Reporte diario — <%= it.report.runDate %> · <code><%= it.report.client.id %></code></div>

  <% if (it.report.aborted) { %>
  <div class="abort">
    <strong>⚠️ Run abortado</strong> por <code><%= it.report.aborted.capability %></code>:
    <br><%= it.report.aborted.reason %>
  </div>
  <% } %>

  <% for (const block of it.report.sections) { %>
  <h2><%= block.title %></h2>
  <% for (const section of block.sections) { %>
    <h3><%= section.heading %></h3>
    <% if (section.body) { %><p><%~ escapeInline(section.body) %></p><% } %>
    <% if (section.bullets && section.bullets.length > 0) { %>
    <ul>
      <% for (const b of section.bullets) { %><li><%~ escapeInline(b) %></li><% } %>
    </ul>
    <% } %>
  <% } %>
  <% } %>

  <% if (it.report.warnings.length > 0) { %>
  <div class="warn-list">
    <strong>Advertencias:</strong>
    <ul>
      <% for (const w of it.report.warnings) { %><li><code><%= w.capability %></code>: <%= w.message %></li><% } %>
    </ul>
  </div>
  <% } %>
</body>
</html>
<%
function escapeInline(s) {
  // Preserva saltos de línea como <br>, escape HTML mínimo
  return String(s).replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;").replace(/\n/g, "<br>");
}
%>
