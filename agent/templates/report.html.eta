<%
const brand = it.report.client.branding ?? { primary: "#1648C0", accent: "#FFD000", logoChar: "📊" };
const p = brand.primary;
const a = brand.accent;
const logoChar = brand.logoChar ?? "📊";

function escHtml(s) {
  return String(s ?? "").replace(/&/g,"&amp;").replace(/</g,"&lt;").replace(/>/g,"&gt;");
}
function brInline(s) {
  return escHtml(s).replace(/\n/g, "<br>");
}
function findSection(kind) {
  for (const block of it.report.sections) {
    for (const s of block.sections) if (s.kind === kind) return s;
  }
  return null;
}
function findIdeasCards() {
  for (const block of it.report.sections) {
    for (const s of block.sections) if (s.cards && s.cards.length > 0) return s.cards;
  }
  return [];
}
function findMetrics() {
  for (const block of it.report.sections) {
    if (block.capability === "instagram_insights") return block;
  }
  return null;
}
const diagnosis = findSection("diagnosis");
const cards = findIdeasCards();
const campaign = findSection("campaign");
const metricsBlock = findMetrics();
%>
<!DOCTYPE html>
<html lang="es">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title><%= it.report.client.clientName %> — <%= it.report.runDate %></title>
<style>
  * { box-sizing: border-box; }
  body {
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", sans-serif;
    max-width: 640px; margin: 0 auto; padding: 20px 16px;
    color: #1a1a1a; background: #f4f5f7; line-height: 1.5;
  }
  .card {
    background: #fff; border-radius: 12px; padding: 20px 22px; margin: 14px 0;
    box-shadow: 0 1px 3px rgba(0,0,0,.05), 0 1px 2px rgba(0,0,0,.03);
  }
  .hero {
    background: linear-gradient(135deg, <%= p %> 0%, <%= p %>dd 100%);
    color: #fff; padding: 28px 24px;
  }
  .hero .logo { font-size: 32px; line-height: 1; }
  .hero h1 { font-size: 22px; margin: 8px 0 2px; font-weight: 700; }
  .hero .date { font-size: 13px; opacity: .85; }
  .hero .accent-bar { height: 4px; background: <%= a %>; border-radius: 2px; margin-top: 16px; }

  .diagnosis { border-left: 4px solid <%= a %>; }
  .diagnosis .label { font-size: 11px; font-weight: 700; letter-spacing: .12em; color: <%= p %>; text-transform: uppercase; margin-bottom: 6px; }
  .diagnosis p { margin: 0; font-size: 15px; color: #333; }

  .section-label {
    font-size: 11px; font-weight: 700; letter-spacing: .14em; color: #666;
    text-transform: uppercase; margin: 26px 0 10px 4px;
  }

  .metrics-row { display: flex; gap: 10px; flex-wrap: wrap; }
  .stat { flex: 1 1 30%; min-width: 100px; background: #fff; border-radius: 10px; padding: 14px 16px; text-align: center; box-shadow: 0 1px 2px rgba(0,0,0,.04); }
  .stat .num { font-size: 20px; font-weight: 700; color: <%= p %>; line-height: 1; }
  .stat .lbl { font-size: 11px; color: #777; margin-top: 4px; }

  .idea { position: relative; padding-top: 22px; }
  .idea-badge {
    display: inline-block; background: <%= p %>; color: #fff; font-size: 10px; font-weight: 800;
    letter-spacing: .1em; padding: 4px 10px; border-radius: 20px;
    position: absolute; top: -10px; left: 20px;
  }
  .idea h2 { font-size: 16px; margin: 0 0 12px; color: #1a1a1a; font-weight: 700; }
  .idea .hook {
    background: <%= a %>22; border-left: 3px solid <%= a %>; padding: 10px 14px;
    border-radius: 0 8px 8px 0; margin: 10px 0 14px; font-size: 14px; color: #333;
  }
  .idea .hook strong { color: <%= p %>; font-size: 10px; letter-spacing: .1em; display: block; margin-bottom: 4px; }
  .idea .field-label { font-size: 10px; font-weight: 700; color: #999; letter-spacing: .1em; text-transform: uppercase; margin: 12px 0 4px; }
  .idea ul { margin: 4px 0 12px; padding-left: 18px; }
  .idea ul li { font-size: 13px; color: #444; margin: 3px 0; }
  .idea .cta { background: #f8f8f8; padding: 10px 14px; border-radius: 8px; font-size: 13px; color: #333; margin: 6px 0 12px; }
  .idea .cta:before { content: "📲 "; }
  .chips { display: flex; flex-wrap: wrap; gap: 6px; margin: 6px 0 10px; }
  .chip {
    background: <%= p %>15; color: <%= p %>; padding: 4px 10px; border-radius: 12px;
    font-size: 11px; font-weight: 600;
  }
  .kpis {
    font-size: 12px; color: #666; margin-top: 8px; padding-top: 10px;
    border-top: 1px dashed #ddd; font-style: italic;
  }
  .kpis:before { content: "📊 "; font-style: normal; }

  .campaign { background: linear-gradient(135deg, <%= a %>22 0%, <%= p %>15 100%); border-left: 4px solid <%= p %>; }
  .campaign h2 { font-size: 15px; margin: 0 0 8px; color: <%= p %>; }
  .campaign ul { margin: 6px 0; padding-left: 20px; }
  .campaign li { font-size: 13px; margin: 4px 0; color: #333; }

  .top-post { display: flex; align-items: flex-start; gap: 10px; padding: 8px 0; border-bottom: 1px solid #f0f0f0; }
  .top-post:last-child { border-bottom: 0; }
  .top-post .fmt {
    background: <%= p %>15; color: <%= p %>; font-size: 9px; font-weight: 800;
    padding: 3px 7px; border-radius: 4px; letter-spacing: .06em; flex-shrink: 0; margin-top: 2px;
  }
  .top-post .body { flex: 1; font-size: 12px; color: #444; }
  .top-post .metrics { font-size: 11px; color: #888; margin-top: 3px; }

  .warnings { background: #fff8e6; border-left: 3px solid #f0b52a; padding: 12px 16px; border-radius: 8px; margin-top: 24px; }
  .warnings summary { font-size: 12px; font-weight: 700; color: #8a6d1a; cursor: pointer; }
  .warnings ul { margin: 8px 0 0; padding-left: 18px; }
  .warnings li { font-size: 11px; color: #6b5411; margin: 2px 0; }
  .warnings code { background: #f0e2b8; padding: 1px 5px; border-radius: 3px; font-size: 10px; }

  .footer { text-align: center; font-size: 11px; color: #999; padding: 20px 0 8px; }
  a { color: <%= p %>; }
</style>
</head>
<body>

  <div class="card hero">
    <div class="logo"><%= logoChar %></div>
    <h1><%= it.report.client.clientName %></h1>
    <div class="date">Ideas del día · <%= it.report.runDate %></div>
    <div class="accent-bar"></div>
  </div>

  <% if (it.report.aborted) { %>
    <div class="card" style="border-left:4px solid #d9534f;">
      <strong>⚠️ Run abortado por <code><%= it.report.aborted.capability %></code></strong>
      <p><%= escHtml(it.report.aborted.reason) %></p>
    </div>
  <% } %>

  <% if (diagnosis) { %>
    <div class="card diagnosis">
      <div class="label">Diagnóstico</div>
      <p><%~ brInline(diagnosis.body) %></p>
    </div>
  <% } %>

  <% if (metricsBlock) { %>
    <% const insightsSect = metricsBlock.sections.find(s => s.heading.startsWith("Resumen")); %>
    <% const topPostsSect = metricsBlock.sections.find(s => s.heading.startsWith("Top")); %>
    <% if (insightsSect) { %>
      <div class="section-label">Pulso de la semana</div>
      <% const m = insightsSect.body.match(/(\d+)\s+publicaciones.*?(\d+)/); %>
      <div class="metrics-row">
        <div class="stat"><div class="num"><%= m ? m[1] : "?" %></div><div class="lbl">Posts</div></div>
        <div class="stat"><div class="num"><%= m ? m[2] : "?" %></div><div class="lbl">Engagement/post</div></div>
        <div class="stat"><div class="num"><%= topPostsSect && topPostsSect.bullets ? topPostsSect.bullets.length : 0 %></div><div class="lbl">Top posts analizados</div></div>
      </div>
    <% } %>
    <% if (topPostsSect && topPostsSect.bullets) { %>
      <div class="card">
        <div class="field-label" style="margin-top:0;font-size:11px;font-weight:700;color:#666;letter-spacing:.1em;text-transform:uppercase;">Top posts</div>
        <% for (const bullet of topPostsSect.bullets) { %>
          <% const fmtMatch = bullet.match(/^\[([A-Z_]+)\]/); %>
          <% const fmt = fmtMatch ? fmtMatch[1].replace("_ALBUM","") : "POST"; %>
          <% const rest = bullet.replace(/^\[[A-Z_]+\]\s*/, ""); %>
          <div class="top-post">
            <span class="fmt"><%= fmt %></span>
            <div class="body"><%~ brInline(rest) %></div>
          </div>
        <% } %>
      </div>
    <% } %>
  <% } %>

  <% if (cards.length > 0) { %>
    <div class="section-label"><%= cards.length %> ideas para publicar</div>
    <% for (const idea of cards) { %>
      <div class="card idea">
        <span class="idea-badge"><%= idea.format %></span>
        <h2><%= idea.title %></h2>
        <% if (idea.hook) { %>
          <div class="hook">
            <strong>HOOK · PRIMEROS 3s</strong>
            <%~ brInline(idea.hook) %>
          </div>
        <% } %>
        <% if (idea.scriptBullets && idea.scriptBullets.length > 0) { %>
          <div class="field-label">Guion</div>
          <ul>
            <% for (const b of idea.scriptBullets) { %><li><%~ brInline(b) %></li><% } %>
          </ul>
        <% } %>
        <% if (idea.cta) { %>
          <div class="field-label">CTA</div>
          <div class="cta"><%~ brInline(idea.cta) %></div>
        <% } %>
        <% if (idea.whyItWorks && idea.whyItWorks.length > 0) { %>
          <div class="field-label">Por qué funciona con el ADN</div>
          <div class="chips">
            <% for (const w of idea.whyItWorks) { %><span class="chip"><%= w %></span><% } %>
          </div>
        <% } %>
        <% if (idea.expectedKPIs) { %>
          <div class="kpis"><%= idea.expectedKPIs %></div>
        <% } %>
      </div>
    <% } %>
  <% } %>

  <% if (campaign) { %>
    <div class="section-label">Campaña de la quincena</div>
    <div class="card campaign">
      <h2><%= campaign.heading.replace(/^Campaña propuesta:\s*/, "") %></h2>
      <% if (campaign.bullets && campaign.bullets.length > 0) { %>
        <ul>
          <% for (const b of campaign.bullets) { %><li><%~ brInline(b) %></li><% } %>
        </ul>
      <% } %>
    </div>
  <% } %>

  <% if (it.report.warnings.length > 0) { %>
    <details class="warnings">
      <summary>⚠️ <%= it.report.warnings.length %> advertencia<%= it.report.warnings.length === 1 ? "" : "s" %> del run (click para expandir)</summary>
      <ul>
        <% for (const w of it.report.warnings) { %><li><code><%= w.capability %></code>: <%= escHtml(w.message) %></li><% } %>
      </ul>
    </details>
  <% } %>

  <div class="footer">Generado por el agente de Juancito Ads · <%= it.report.client.id %></div>

</body>
</html>
